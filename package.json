{
  "name": "@helloagent/helloagent-hermes",
  "version": "0.1.0",
  "description": "Bridge between HelloAgent's relay and a Hermes Agent gateway. HelloAgent users chat with their personal Hermes through the same UX as any HelloAgent contact.",
  "type": "module",
  "private": true,
  "bin": {
    "helloagent-hermes": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@helloagent/sdk": "file:../../sdk-ts",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
