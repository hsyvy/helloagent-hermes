{
  "name": "@helloagentai/hermes",
  "version": "0.1.0",
  "description": "Bridge between the HelloAgent server and a Hermes Agent gateway. HelloAgent users chat with their personal Hermes through the same UX as any HelloAgent contact.",
  "license": "MIT",
  "author": "HelloAgent",
  "homepage": "https://github.com/helloagentai/helloagent-hermes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloagentai/helloagent-hermes.git"
  },
  "bugs": {
    "url": "https://github.com/helloagentai/helloagent-hermes/issues"
  },
  "keywords": [
    "helloagent",
    "hermes",
    "bridge",
    "agent"
  ],
  "type": "module",
  "bin": {
    "helloagent-hermes": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@helloagentai/sdk": "^0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
